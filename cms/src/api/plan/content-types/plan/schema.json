{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Insurance plan of a country (content-model 2.3). Shown only if published and active."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 80,
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "maxLength": 300
    },
    "basePrice": {
      "type": "integer",
      "min": 1,
      "required": true
    },
    "currency": {
      "type": "string",
      "regex": "^[A-Z]{3}$",
      "required": true
    },
    "coverages": {
      "type": "component",
      "repeatable": true,
      "component": "plan.plan-item"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "plan.plan-item"
    },
    "order": {
      "type": "integer"
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "plans"
    }
  }
}
