# Example environment for `docker compose up` (CLAUDE.md section 6).
#
# All values are FICTITIOUS and public. docker-compose.yml loads this file first so the
# stack starts with a single command after cloning; a local `.env` (never versioned,
# see .gitignore) overrides any value. Use real random secrets in `.env` for anything
# that is not a local demo.
#
# There is NO Strapi API token here or anywhere in the project (ADR-0003, G3-3):
# the browser and the e2e only read through nginx as the public role.
# API_TOKEN_SALT and TRANSFER_TOKEN_SALT are salts that Strapi requires at start-up
# to hash tokens created in the admin; they are not tokens.

# Strapi secrets (fictitious)
APP_KEYS=ZmljdGljaW91cy1hcHAta2V5LTE=,ZmljdGljaW91cy1hcHAta2V5LTI=
API_TOKEN_SALT=ZmljdGljaW91cy1hcGktdG9rZW4tc2FsdA==
ADMIN_JWT_SECRET=ZmljdGljaW91cy1hZG1pbi1qd3Qtc2VjcmV0
TRANSFER_TOKEN_SALT=ZmljdGljaW91cy10cmFuc2Zlci1zYWx0
JWT_SECRET=ZmljdGljaW91cy11c2Vycy1wZXJtaXNzaW9ucy1qd3Q=
ENCRYPTION_KEY=ZmljdGljaW91cy1lbmNyeXB0aW9uLWtleQ==

# Database: SQLite file inside the cms-data volume (mounted at /opt/app/.tmp)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Admin panel: no calls to Strapi's NPS survey or EE promotion
FLAG_NPS=false
FLAG_PROMOTE_EE=false
